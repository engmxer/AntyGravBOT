# Bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Company config file (relative to project root)
COMPANY_CONFIG=configs/beauty_studio.yaml

# Database URL (SQLite by default; replace with PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/booking.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/booking_db

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Notification chat/group ID for new bookings
NOTIFY_CHAT_ID=-100123456789

# Timezone
TZ=Europe/Moscow

# Reminder hours before appointment
REMINDER_HOURS=2

# Log level
LOG_LEVEL=INFO
